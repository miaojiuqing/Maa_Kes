    "工具-剧情跳过-点击跳过按钮": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                // ROI 左边界原为 976，会切掉图标左侧约 14px，导致永远匹配不全。
                // 实测图标本体位于 x 962~1002，这里左扩到 950 留出余量。
                "roi": [
                    950,
                    0,
                    120,
                    88
                ],
                // 跳过按钮是半透明图标直接叠在剧情画面上，模板里 85% 面积是背景。
                // 背景随剧情场景变化，普通匹配分数会掉到 0.45~0.53（阈值 0.7）而永久失配。
                // 模板已改为 green_mask 版本（非图标像素涂纯绿），只比对图标本体。
                "green_mask": true,
                "template": [
                    "单线程工具/剧情跳过/跳过按钮.png"
                ]
            }
        },
        "action": "Click",
        "post_delay": 500,
        "pre_delay": 150,
        "next": [
            "工具-剧情跳过-跳过确认",
            "工具-剧情跳过-点击跳过按钮",
            "[JumpBack]工具-剧情跳过-点击自动播放",
            "[JumpBack]工具-剧情跳过-左上角说话",
            "[JumpBack]工具-剧情跳过-有人说话_右下角",
            "[JumpBack]空任务"
        ]
    },
    "工具-剧情跳过-跳过确认": {
        // 原本认标题文字（跳过确认.png），但繁中客户端文案是「確定要跳過當前對話嗎？」，
        // 且弹窗布局与简中不同，原 ROI [558,259,187,74] 实际落在「主要登場人物」上，
        // 两个模板实测只有 0.33~0.51，恒失配。
        // 改为识别橙色「確認」按钮色块：不含文字，简繁通用，比认标题稳得多。
        // 实测按钮 x649 y524 w390 h56。
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    600,
                    500,
                    500,
                    110
                ],
                "method": 40,
                "lower": [
                    5,
                    120,
                    150
                ],
                "upper": [
                    25,
                    255,
                    255
                ],
                "count": 8000
            }
        },
        "next": [
            "工具-剧情跳过-跳过确认-不再显示-已选择",
            "工具-剧情跳过-跳过确认-不再显示-未选择"
        ]
    },
    "工具-剧情跳过-跳过确认-不再显示-已选择": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                // 繁中确认框比简中更高，勾选框实测在 (526,462)，
                // 原 ROI [494,338,95,92]（y 338~430）整个落空，差约 32px。
                "roi": [
                    500,
                    440,
                    110,
                    75
                ],
                "threshold": [
                    0.85
                ],
                "template": [
                    "单线程工具/剧情跳过/已选中不再显示.png"
                ]
            }
        },
        // 已勾选「不再显示」后点「確認」。原坐标 [677,436,330,36] 是简中布局，
        // 繁中下按钮实测在 x649 y524 w390 h56，y 差 88px 会点空。
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    649,
                    524,
                    390,
                    56
                ]
            }
        },
        "next": [
            "工具-剧情跳过-跳过确认-不再显示-已选择",
            "工具-剧情跳过-点击跳过按钮",
            "[JumpBack]空任务"
        ]
    },
    "工具-剧情跳过-跳过确认-不再显示-未选择": {
