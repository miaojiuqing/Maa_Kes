{
    "task": [
        {
            "name": "进入游戏",
            "label": "🎮进入游戏",
            "default_check": true,
            "group": [
                "日常"
            ],
            "entry": "进游戏-任务开始层",
            "description": "暂不支持国服和国际服之外的模拟器游戏自启动,若有需要麻烦提供包名\n\nPC端使用请用管理员模式启动不然连接不上窗口\n\n分辨率一定要是16：9",
            "pipeline_override": {
                "进游戏-点击进入游戏": {
                    "enabled": true
                }
            },
            "option": [
                "模拟器自启动游戏"
            ]
        }
    ],
    "option": {
        "模拟器自启动游戏": {
            "type": "switch",
            "controller": [
                "安卓端"
            ],
            "description": "目模拟器通过包名启动,PC端暂无方法直接启动游戏",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "option": [
                        "模拟器包名启动"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "进游戏-任务开始层": {
                            "action": "DoNothing"
                        }
                    }
                }
            ]
        },
        "模拟器包名启动": {
            "label": "渠道选择",
            "type": "select",
            "controller": [
                "安卓端"
            ],
            "resource": [
                "简中"
            ],
            "cases": [
                {
                    "name": "国服",
                    "pipeline_override": {
                        "进游戏-任务开始层": {
                            "action": "StartApp",
                            "package": "com.tencent.czn"
                        }
                    }
                },
                {
                    "name": "国际服",
                    "pipeline_override": {
                        "进游戏-任务开始层": {
                            "action": "StartApp",
                            "package": "com.smilegate.chaoszero.stove.google"
                        }
                    }
                }
            ]
        }
    }
}
