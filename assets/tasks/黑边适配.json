                "桌面端"
            ],
            "default_check": false,
            "group": [
                "日常"
            ],
            "entry": "黑边适配",
            "description": "适用于存在上下黑边的屏幕（例如 16:10）。请放在任务队列最前面，与日常任务一起运行，运行中勿调整窗口大小。取消勾选不会关闭已启用的适配；关闭下方开关后运行一次，或重启工具即可恢复。",
            "option": [
                "黑边适配-启用"
            ]
        }
    ],
    "option": {
        "黑边适配-启用": {
            "label": "启用剪裁",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "黑边适配": {
                            "custom_action_param": {
                                "enabled": false
                            },
                            "focus": {
                                "Node.Action.Succeeded": "已关闭黑边适配"
                            }
                        }
                    }
                }
            ]
        }
