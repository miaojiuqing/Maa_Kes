// 繁中客户端「跳过剧情」确认框的布局覆盖，仅在「繁中」资源下生效（叠加在 ./resource 之上）。
// 繁中确认框比简中高，内部元素整体下移：
//   - 「不再显示」勾选框实测在 (526,462)，简中 ROI [494,338,95,92] 整个落空
//   - 「確認」按钮实测 x649 y524 w390 h56，简中坐标 y436 会点空
// 标题文案也不同（「確定要跳過當前對話嗎？」），所以「跳过确认」不认标题，
// 改为「勾选框模板」与「橙色確認按钮色块」同时满足。只认橙色的话，
// 关卡结算页的紫色確認按钮在 HSV 下能算出 6148（阈值 8000），有误判风险；
// 结算页没有勾选框，加上 And 条件后可排除。
{
    "工具-剧情跳过-跳过确认": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [
                                    500,
                                    440,
                                    110,
                                    75
                                ],
                                "template": [
                                    "单线程工具/剧情跳过/未选中不再显示.png",
                                    "单线程工具/剧情跳过/已选中不再显示.png"
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [
                                    600,
                                    500,
                                    500,
                                    110
                                ],
                                "method": 40,
                                "lower": [
                                    5,
                                    120,
                                    150
                                ],
                                "upper": [
                                    25,
                                    255,
                                    255
                                ],
                                "count": 8000
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        }
    },
    "工具-剧情跳过-跳过确认-不再显示-已选择": {
        "recognition": {
            "param": {
                "roi": [
                    500,
                    440,
                    110,
                    75
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    649,
                    524,
                    390,
                    56
                ]
            }
        }
    },
    "工具-剧情跳过-跳过确认-不再显示-未选择": {
        "recognition": {
            "param": {
                "roi": [
                    500,
                    440,
                    110,
                    75
                ]
            }
        }
    },
    "工具-自动推图-跳过确认": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [
                                    500,
                                    440,
                                    110,
                                    75
                                ],
                                "template": [
                                    "单线程工具/剧情跳过/未选中不再显示.png",
                                    "单线程工具/剧情跳过/已选中不再显示.png"
                                ]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [
                                    600,
                                    500,
                                    500,
                                    110
                                ],
                                "method": 40,
                                "lower": [
                                    5,
                                    120,
                                    150
                                ],
                                "upper": [
                                    25,
                                    255,
                                    255
                                ],
                                "count": 8000
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        }
    },
    "工具-自动推图-跳过确认-不再显示-已选择": {
        "recognition": {
            "param": {
                "roi": [
                    500,
                    440,
                    110,
                    75
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    649,
                    524,
                    390,
                    56
                ]
            }
        }
    },
    "工具-自动推图-跳过确认-不再显示-未选择": {
        "recognition": {
            "param": {
                "roi": [
                    500,
                    440,
                    110,
                    75
                ]
            }
        }
    }
}
